{"outputDirectory":"web","cleanUrls":false,"trailingSlash":false,
"functions":{"api/page.js":{"includeFiles":"web/assets/{defaults,config}.js"}},
"redirects":[
{"source":"/index.html","destination":"/","permanent":true},
{"source":"/tests.html","destination":"/lab-tests","permanent":true},
{"source":"/reports.html","destination":"/reports","permanent":true}],
"rewrites":[
{"source":"/","destination":"/api/page?p=home"},
{"source":"/services","destination":"/api/page?p=services"},
{"source":"/doctors","destination":"/api/page?p=doctors"},
{"source":"/lab-tests","destination":"/api/page?p=tests"},
{"source":"/test-panels","destination":"/api/page?p=panels"},
{"source":"/gallery","destination":"/api/page?p=gallery"},
{"source":"/faq","destination":"/api/page?p=faq"},
{"source":"/contact","destination":"/api/page?p=contact"},
{"source":"/about","destination":"/api/page?p=about"},
{"source":"/reports","destination":"/api/page?p=reports"},
{"source":"/llms.txt","destination":"/api/page?p=llms"},
{"source":"/blog","destination":"/api/blog"},
{"source":"/blog/:slug","destination":"/api/blog?slug=:slug"},
{"source":"/sitemap.xml","destination":"/api/blog?sitemap=1"},
{"source":"/admin","destination":"/admin/index.html"}],
"headers":[
{"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=60, stale-while-revalidate=604800"}]},
{"source":"/img/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=604800, stale-while-revalidate=2592000"}]},
{"source":"/favicon.png","headers":[{"key":"Cache-Control","value":"public, max-age=86400, stale-while-revalidate=604800"}]},
{"source":"/admin(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex"}]}]}
